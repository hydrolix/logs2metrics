{
  "permissions": {
    "deny": [
      "Bash(gh pr create *--repo mercereau/hydrolix-metrics-go*)",
      "Bash(gh pr create *--repo=mercereau/hydrolix-metrics-go*)",
      "Bash(gh pr create *-R mercereau/hydrolix-metrics-go*)",
      "Bash(gh pr create *-R=mercereau/hydrolix-metrics-go*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-upstream-pr.py\""
          }
        ]
      },
      {
        "matcher": "mcp__.*create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-upstream-pr.py\""
          }
        ]
      }
    ]
  }
}
